{
  "name": "rotmg-companion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Realm of the Mad God Exalt new-player companion (desktop).",
  "author": "RotMG Companion",
  "repository": "https://github.com/pendragonzzz/rotmg-companion",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "pack": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "refresh": "tsx scripts/refresh-data.ts",
    "parse:fixture": "tsx scripts/parse-fixture.ts",
    "test:readiness": "tsx scripts/test-readiness.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:wiki": "tsx scripts/test-wiki.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
